# Copy to .env. With LLM_PROVIDER=mock (default) no key is needed: tests, CI and the baseline evaluation run offline.
LLM_PROVIDER=mock              # mock | openai_compatible | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
CHEAP_MODEL=openai/gpt-oss-20b
STRONG_MODEL=openai/gpt-oss-120b
# USD per 1M tokens, used only for cost logging/budgets
CHEAP_PRICE_IN=0.05
CHEAP_PRICE_OUT=0.08
STRONG_PRICE_IN=0.59
STRONG_PRICE_OUT=0.79
MAX_STEPS=8
MAX_COST_USD=0.05
